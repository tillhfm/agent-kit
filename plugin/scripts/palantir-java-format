#!/usr/bin/env python3
"""Runs the native palantir-java-format of the version in gradle/libs.versions.toml with the given arguments.

It looks for the catalog from the working directory upwards and reads its `palantir-java-format` version. The
binary comes from Maven Central once per version and platform, checked against the SHA-256 published beside it,
and stays in ~/.cache/agent-kit.
"""

import hashlib
import os
import platform
import re
import sys
import urllib.request

CENTRAL = "https://repo1.maven.org/maven2/com/palantir/javaformat/palantir-java-format-native"
PLATFORMS = {
    ("Darwin", "arm64"): "macos_aarch64",
    ("Linux", "x86_64"): "linux-glibc_x86-64",
    ("Linux", "aarch64"): "linux-glibc_aarch64",
}


def version():
    folder = os.getcwd()
    while True:
        catalog = os.path.join(folder, "gradle", "libs.versions.toml")
        if os.path.isfile(catalog):
            with open(catalog) as f:
                found = re.search(r'^palantir-java-format\s*=\s*"([^"]+)"', f.read(), re.MULTILINE)
            if found:
                return found.group(1)
            sys.exit(f"palantir-java-format: {catalog} has no palantir-java-format version")
        parent = os.path.dirname(folder)
        if parent == folder:
            sys.exit("palantir-java-format: no gradle/libs.versions.toml above the working directory")
        folder = parent


def binary(ver):
    target = PLATFORMS.get((platform.system(), platform.machine()))
    if not target:
        sys.exit(f"palantir-java-format: no native binary for {platform.system()} {platform.machine()}")
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "agent-kit")
    path = os.path.join(cache, f"palantir-java-format-{ver}-{target}")
    if os.path.isfile(path):
        return path
    url = f"{CENTRAL}/{ver}/palantir-java-format-native-{ver}-nativeImage-{target}.bin"
    data = urllib.request.urlopen(url).read()
    expected = urllib.request.urlopen(url + ".sha256").read().decode().split()[0]
    if hashlib.sha256(data).hexdigest() != expected:
        sys.exit(f"palantir-java-format: {url} does not match its SHA-256")
    os.makedirs(cache, exist_ok=True)
    partial = path + ".part"
    with open(partial, "wb") as f:
        f.write(data)
    os.chmod(partial, 0o755)
    os.replace(partial, path)
    return path


tool = binary(version())
os.execv(tool, [tool, *sys.argv[1:]])
